# Cloudflare Pages đọc file này. GitHub Pages bỏ qua (vô hại).
# Audio và toàn văn không bao giờ đổi nội dung dưới cùng một tên file → cache lâu.
/data/audio/*
  Cache-Control: public, max-age=31536000, immutable

/data/book.js
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=86400
